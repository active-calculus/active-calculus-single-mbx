<worksheet label="ws-act-5-6-1">
   
    <activity xml:id="act-5-6-1" workspace="3cm">
      <introduction>
        <p>
      In this activity,
      we explore the relationships among the errors generated by left, right,
      midpoint,
      and trapezoid approximations to the definite integral <m>\int_1^2 \frac{1}{x^2} \, dx</m>.

      </p>
      </introduction>
      <task workspace="4cm" xml:id="act-5-6-1-task-0">
        <statement>
          <p>
            Use the First FTC to evaluate <m>\int_1^2 \frac{1}{x^2} \, dx</m> exactly.
          </p>
        </statement>
        <hint>
          <p><m>\frac{1}{x^2} = x^{-2}</m>.
          </p>
        </hint>
        <answer>
          <p><m>\int_1^2 \dfrac{1}{x^2} dx = \dfrac{1}{2}</m>.
          </p>
        </answer>
        <solution>
          <p><m>\int_1^2 \dfrac{1}{x^2} dx = \left. -x^{-1} \right|_1^2 = -\dfrac{1}{2} + 1 = \dfrac{1}{2}</m>.
          </p>
        </solution>
      </task>
      <task workspace="4cm" xml:id="act-5-6-1-task-1">
        <statement>
          <p>
            Use appropriate computing technology to compute the following approximations for <m>\int_1^2 \frac{1}{x^2} \, dx</m>:
            <m>T_4</m>, <m>M_4</m>,
            <m>T_8</m>, and <m>M_8</m>.
          </p>
        </statement>
        <hint>
          <p>
            Use a computational device.
          </p>
        </hint>
        <answer>
          <p>
            The table below gives values of the trapezoid rule and corresponding errors for different <m>n</m>-values.
          </p>
            <tabular top="minor" bottom="minor">
              <row bottom="medium">
                <cell><m>n</m></cell>
                <cell><m>T_n</m></cell>
                <cell><m>E_{T,n}</m></cell>
              </row>
              <row>
                <cell><m>4</m></cell>
                <cell><m>0.50899</m></cell>
                <cell><m>0.00899</m></cell>
              </row>
              <row>
                <cell><m>8</m></cell>
                <cell><m>0.50227</m></cell>
                <cell><m>0.00227</m></cell>
              </row>
              <row>
                <cell><m>16</m></cell>
                <cell><m>0.50057</m></cell>
                <cell><m>0.00057</m></cell>
              </row>
            </tabular>
        </answer>
        <solution>
          <p>
            The table below gives values of the trapezoid rule and corresponding errors for different <m>n</m>-values.
          </p>
            <tabular top="minor" bottom="minor" permid="ilE">
              <row bottom="medium">
                <cell><m>n</m></cell>
                <cell><m>T_n</m></cell>
                <cell><m>E_{T,n}</m></cell>
              </row>
              <row>
                <cell><m>4</m></cell>
                <cell><m>0.50899</m></cell>
                <cell><m>0.00899</m></cell>
              </row>
              <row>
                <cell><m>8</m></cell>
                <cell><m>0.50227</m></cell>
                <cell><m>0.00227</m></cell>
              </row>
