  <setup>
    <selectFromSequence name="a" from="0.3" to="0.5" step="0.1"/>
    <selectFromSequence name="b" from="1.3" to="1.8" step="0.1"/>
    <selectFromSequence name="c" from="1" to="3" step="1"/>
    <function name="s" symbolic="false" >
      $b*x^2
    </function>

    <repeatForSequence from="0" to="5" valueName="n" name="pos">
      <round numDecimals="4">
        $$s($n*$a)
      </round>
    </repeatForSequence>

  </setup>

  <p>
    Consider a car whose position <m>s</m> (in feet) at time <m>t</m> (in seconds) is given by the table:
  </p>

  <tabular top="minor" bottom="minor" left="minor" right="minor">
    <row>
      <cell><m>t</m> (sec)</cell>
      <cell><m>0</m></cell>
      <cell><math simplify>$a</math></cell>
      <cell><math simplify>2$a</math></cell>
      <cell><math simplify>3$a</math></cell>
      <cell><math simplify>4$a</math></cell>
      <cell><math simplify>5$a</math></cell>
    </row>
    <row>
      <cell><m>s</m> (feet)</cell>
      <cell>$pos[1]</cell>
      <cell>$pos[2]</cell>
      <cell>$pos[3]</cell>
      <cell>$pos[4]</cell>
      <cell>$pos[5]</cell>
      <cell>$pos[6]</cell>
    </row>
  </tabular>

  <p>
    <ol marker="a">
      <li>
        <p> What are the units on the average velocity of the car? </p>
          <answer>
            <choiceInput name="choice1" inline>
              <shortDescription>units of average velocity</shortDescription>
              <choice>miles per hour</choice>
              <choice>feet</choice>
              <choice credit="1">feet per second</choice>
              <choice>seconds</choice>
            </choiceInput>
          </answer>
      </li>
      <li>
        <p>Find the average velocity of the car on the interval <m>0 \le t \le <math simplify>3*$a</math>.</m> </p>
        <p>
          <answer allowedErrorInNumbers="0.01" allowedErrorIsAbsolute="true"><shortDescription>average velocity on an interval</shortDescription>
          ($pos[4]-$pos[1])/(3*$a)
      </answer>
        </p>
      </li>
      <li>
        <p>
          Find the average velocity of the car on the interval <m>[<math simplify>$c*$a</math>, <math simplify>($c+2)*$a</math>]</m>.
        </p>
        <p>
          <answer allowedErrorInNumbers="0.01" allowedErrorIsAbsolute="true">
            <shortDescription>average velocity on another interval</shortDescription>
          ($pos[$c+3]-$pos[$c+1])/(2*$a)
      </answer>
        </p>
      </li>
    </ol>
  </p>
