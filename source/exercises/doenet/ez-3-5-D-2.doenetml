<setup>
  <selectFromSequence name = "a" from = "-3" to = "3" step = "1" exclude="-1 0 1"/>
  <selectFromSequence name = "b" from = "2" to = "6" step = "1" exclude="4 $a"/>
  <selectFromSequence name = "c" from = "-3" to = "3" step = "1" exclude="0 $a $b"/>

  <selectFromSequence name = "p" from = "-3" to = "1" step = "1" exclude="0"/>
  <selectFromSequence name = "q" from = "3" to = "6" step = "1" exclude="abs($p)"/>

  <function name="f">$a*x/(x^2 + $b) + $c</function>
  <derivative name="fP">$f</derivative>
  <function name="fextrema" domain="[$p,$q]">$f</function>

  <number name="crNum1" displayDecimals="5">-sqrt($b)</number>
  <number name="crNum2" displayDecimals="5">sqrt($b)</number>

  <mathList name="crNums"> $crNum1 $crNum2 </mathList>
  <boolean name="Num1in">$crNum1>= $p and $crNum1<= $q</boolean>
  <boolean name="Num2in">$crNum2>= $p and $crNum2<= $q</boolean>

  <math name="fofcrNums">
    <conditionalContent>
      <case condition="!$Num1in and !$Num2in">none</case>
      <else>
        <mathList>
        <conditionalContent condition="$Num1in">$$f($crNum1)</conditionalContent>
        <conditionalContent condition="$Num2in">$$f($crNum2)</conditionalContent>
          </mathList>
      </else>
    </conditionalContent>
  </math>

</setup>

<p>
  Consider the function <conditionalContent><case condition="$c<0"><m>f(x) = \frac{$a x}{x^2 + $b} <math simplify>+$c</math></m></case><else><m>f(x) = \frac{$a x}{x^2 + $b} +$c</m></else></conditionalContent> on the interval <m>[$p,$q]</m>. Use calculus to find the exact absolute minimum and absolute maximum of <m>f</m> on this interval.
</p>

<p>
  <ol marker="a.">
    <li>
      <p>
        For <conditionalContent><case condition="$c<0"><m>f(x) = \frac{$a x}{x^2 + $b} <math simplify>+$c</math></m></case><else><m>f(x) = \frac{$a x}{x^2 + $b} +$c</m></else></conditionalContent>, it follows that 
      </p>
      <p>
        <answer>
          <label>
            <m>f'(x)=</m>
          </label>
          $fP
        </answer>
      </p>

      <p>
        Find all critical numbers of <m>f</m> exactly.  If there is more than one critical number, enter them as a list separated by commas.  If there are none, enter <em>none</em>.  (<alert>Note</alert>: the exact value may involve a square root, such as <m>\sqrt{2}</m>.  If so, enter <q><m>\sqrt{2}</m></q>, not a decimal approximation such as <m>1.414</m>.)
      </p>
      <p>
        <answer unorderedCompare matchPartial><label>The exact critical numbers of <m>f</m> are: <m>x=</m> </label>$crNums</answer>
      </p>
      <p>
        Evaluate the function at any critical numbers that lie in the interval <m>[$p,$q]</m>.  If there is more than one such critical number, enter the function values as a list separated by commas.  If there are no critical numbers in the interval <m>[$p,$q]</m>, enter <em>none</em>.
      </p>
      <answer unorderedCompare matchPartial allowedErrorInNumbers="0.01" allowedErrorIsAbsolute>
        <label>The value(s) of <m>f</m> at any applicable critical numbers are:</label>
        $fofcrNums
        <!-- <conditionalContent>
          <case condition="$crNum>= $p and $crNum<= $q">$$f($crNum)</case>
          <else>none</else>
        </conditionalContent> -->
      </answer>

    </li>
    <li>
      <p>
        The values of the function at the respective endpoints of the interval are:
      </p>
      <p>
        <answer allowedErrorInNumbers="0.01" allowedErrorIsAbsolute><label><m>f($p) =</m></label>$$f($p)</answer> and <answer allowedErrorInNumbers="0.01" allowedErrorIsAbsolute><label><m>f($q) =</m></label>$$f($q)</answer>
      </p>
    </li>
    <li>
      <p>
        <answer allowedErrorInNumbers="0.01" allowedErrorIsAbsolute><label>The absolute minimum value of <m>f</m> on <m>[$p,$q]</m> is </label>$fextrema.globalMinimum[2]</answer>
      </p>
      <p>
        <answer allowedErrorInNumbers="0.01" allowedErrorIsAbsolute><label>The absolute maximum value of <m>f</m> on <m>[$p,$q]</m> is </label>$fextrema.globalMaximum[2]</answer>
      </p>
    </li>
  </ol>
</p>
