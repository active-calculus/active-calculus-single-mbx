  <setup>
    <selectFromSequence name="a" from="1" to="3" step="1"/>
    <selectFromSequence name="b" from="1" to="6" step="1"/>
    <matrix name="M">
      <row> 2.7 3.2 4 4.6 5.4 5.9 </row>
      <row> 5.4 6.5 8.1 9.2 10.8 11.9 </row>
      <row> 6.0 6.9 8.7 9.8 11.6 12.7 </row>
     </matrix>
    <textList name="activity"> walking biking swimming</textList>
    <numberList name="weight">100 120 150 170 200 220</numberList>
    <math simplify name="ans1">$M.matrix[$a][$b] * 30</math>
   </setup>

  <p>
    The table below shows the number of calories used per minute as a function of an individual's body weight for three sports:
  </p>
    <tabular>
      <row bottom="major" header>
        <cell right="major">Activity</cell>
        <cell>100 lb</cell>
        <cell>120 lb</cell>
        <cell>150 lb</cell>
        <cell>170 lb</cell>
        <cell>200 lb</cell>
        <cell>220 lb</cell>
      </row>
      <row>
        <cell right="major">Walk</cell>
        <cell>$M.matrix[1][1]</cell>
        <cell>$M.matrix[1][2]</cell>
        <cell>$M.matrix[1][3]</cell>
        <cell>$M.matrix[1][4]</cell>
        <cell>$M.matrix[1][5]</cell>
        <cell>$M.matrix[1][6]</cell>
      </row>
      <row>
        <cell right="major">Bike</cell>
        <cell>$M.matrix[2][1]</cell>
        <cell>$M.matrix[2][2]</cell>
        <cell>$M.matrix[2][3]</cell>
        <cell>$M.matrix[2][4]</cell>
        <cell>$M.matrix[2][5]</cell>
        <cell>$M.matrix[2][6]</cell>
      </row>
      <row>
        <cell right="major">Swim</cell>
        <cell>$M.matrix[3][1]</cell>
        <cell>$M.matrix[3][2]</cell>
        <cell>$M.matrix[3][3]</cell>
        <cell>$M.matrix[3][4]</cell>
        <cell>$M.matrix[3][5]</cell>
        <cell>$M.matrix[3][6]</cell>
      </row>
    </tabular>

  <p>
    <ol marker="a">

    <setup>
        <selectFromSequence name="x" from="1" to="3" step="1"/>
        <selectFromSequence name="y" from="1" to="6" step="1"/>
        <math simplify name="ans5">$M.matrix[$x][$y] * 15</math>
    </setup>

        <li>
            <p>
                Determine the total number of calories that a $weight[$y] lb person uses in 15 minutes of $activity[$x].
            </p>
            <p>
              <answer><shortDescription>calories burned</shortDescription>$ans5</answer>
            </p>
        </li>


        <li>
            <p>
                Determine the total number of calories that a $weight[$b] lb person uses in one half-hour of $activity[$a].
            </p>
            <p>
              <answer><shortDescription>calories burned</shortDescription>$ans1</answer>
            </p>
        </li>

    <!--     <hint>Don't forget to include units!</hint> -->

        <setup>
            <selectFromSequence name="c" from="1" to="3" step="1"/>
            <selectFromSequence name="d" from="4" to="6" step="1"/>
            <math simplify name="ans2">$M.matrix[3][$c] * 60 </math>
            <math simplify name="ans3">$M.matrix[2][$d] * 30 </math>
        </setup>

        <li>
            <p>
                Who uses more total calories, a $weight[$c] lb person swimming for one hour, or a $weight[$d] lb person biking for a half-hour?
              <answer>
        <choiceInput><shortDescription>who burned more calories doing the specified activity</shortDescription>
        <choice credit="1">The $weight[$c] lb person swimming for one hour</choice>
        <choice>The $weight[$d] lb person biking for a half-hour</choice>
        <choice>They both use the same amount of calories</choice>
        </choiceInput>
    </answer>
            </p>
        </li>


<!--
    <li>Does the number of calories of a person $activity.texts[$a] increase or decrease as weight increases?
    </li>
    <answer>
    <choiceInput>
      <choice credit="1">Increase</choice>
      <choice>Decrease</choice>
    </choiceInput>
    </answer>
-->

  </ol>
</p>  