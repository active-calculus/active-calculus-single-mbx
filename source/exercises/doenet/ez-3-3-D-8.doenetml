<setup>
  <selectFromSequence name = "a" from = "5" to = "6" step = "1"/>
  <selectFromSequence name = "b" from = "-1" to = "1" step = "2"/>
  <selectFromSequence name = "c" from = "-4" to = "4" step = "2" exclude="0"/>

  <number name="end">12</number>

  <function name="fP">$c(x+$a)(x-$b)^2(x-$a)</function>
  <derivative name="fPP">$fP</derivative>

  <!-- <lineSegment name="numline" endpoints="(-$end+0.5,0) ($end-0.5,0)" styleNumber="5" lineWidth="3"/> -->
  <vector name="numline1" tail="(0,0)" head="($end-.5,0)" styleNumber="5" fixed lineWidth="3"/>
  <vector name="numline2" tail="(0,0)" head="(-$end+.5,0)" styleNumber="5" fixed lineWidth="3"/>
  <lineSegment name="hash1" endpoints="(-$a,-0.25) (-$a,0.25)" styleNumber="5" fixed lineWidth="2"/>
  <lineSegment name="hash2" endpoints="($b,-0.25) ($b,0.25)" styleNumber="5" fixed lineWidth="2"/>
  <lineSegment name="hash3" endpoints="($a,-0.25) ($a,0.25)" styleNumber="5" fixed lineWidth="2"/>

  <lineSegment name="dash1" endpoints="(-$a,0.25) (-$a,1.5)" styleNumber="6" draggable="false"/>
  <lineSegment name="dash2" endpoints="($b,0.25) ($b,1.5)" styleNumber="6" fixed/>
  <lineSegment name="dash3" endpoints="($a,0.25) ($a,1.5)" styleNumber="6" fixed/>
  
  
  <!-- <point name="B" styleNumber="1" draggable="false">($POI1,$$fP($POI1))</point>
  <point name="C" styleNumber="1" draggable="false">($POI2,$$fP($POI2))</point> -->

  <mathList name="correctCrNum">-$a $b $a</mathList>

  <!--
  <number name="POI1"> 1/3 * (-sqrt($a^2 + $a*$c + $c^2) - $a + $c)</number>
  <number name="POI2"> 1/3 * (sqrt($a^2 + $a*$c + $c^2) - $a + $c)</number>
    <number name="midPOI">($POI1 + $POI2)/2</number>
   <mathList name="correctPOI">$POI1 $POI2</mathList>
  -->

  <!-- <boolean name="condition1">($pm1=POS and $$fP(-$a-1) > 0) or ($pm1=NEG and $$fP(-$a-1) < 0)</boolean>
  <boolean name="condition2">($pm2=POS and $$fP(-$a+1) > 0) or ($pm2=NEG and $$fP(-$a+1) < 0)</boolean>
  <boolean name="condition3">($pm3=POS and $$fP($b+1) > 0) or ($pm3=NEG and $$fP($b+1) < 0)</boolean>
  <boolean name="condition4">($pm4=POS and $$fP($a+1) > 0) or ($pm4=NEG and $$fP($a+1) < 0)</boolean> -->

  <boolean name="condition1">($pm1=<text>+</text> and $$fP(-$a-1) > 0) or ($pm1=<text>-</text> and $$fP(-$a-1) < 0)</boolean>
  <boolean name="condition2">($pm2=<text>+</text> and $$fP(-$a+1) > 0) or ($pm2=<text>-</text> and $$fP(-$a+1) < 0)</boolean>
  <boolean name="condition3">($pm3=<text>+</text> and $$fP($b+1) > 0) or ($pm3=<text>-</text> and $$fP($b+1) < 0)</boolean>
  <boolean name="condition4">($pm4=<text>+</text> and $$fP($a+1) > 0) or ($pm4=<text>-</text> and $$fP($a+1) < 0)</boolean>

  <boolean name="condition1a">($ID1=INC and $$fP(-$a-1) > 0) or ($ID1=DEC and $$fP(-$a-1) < 0)</boolean>
  <boolean name="condition2a">($ID2=INC and $$fP(-$a+1) > 0) or ($ID2=DEC and $$fP(-$a+1) < 0)</boolean>
  <boolean name="condition3a">($ID3=INC and $$fP($b+1) > 0) or ($ID3=DEC and $$fP($b+1) < 0)</boolean>
  <boolean name="condition4a">($ID4=INC and $$fP($a+1) > 0) or ($ID4=DEC and $$fP($a+1) < 0)</boolean>

  <boolean name="condition5">($crNum1Beh.selectedIndices=1 and $$fP(-$a-1) < 0) or ($crNum1Beh.selectedIndices=2 and $$fP(-$a-1) > 0)</boolean>
  <boolean name="condition6">$crNum2Beh.selectedIndices=3</boolean>
  <boolean name="condition7">($crNum3Beh.selectedIndices=1 and $$fP($a-1) < 0) or ($crNum3Beh.selectedIndices=2 and $$fP($a-1) > 0)</boolean>
  
</setup>


<p>
  Consider a function <m>y = f(x)</m> whose <em>derivative</em> is given by the formula
  <me>
    f'(x) = $c(x+$a)(<math simplify>x-$b</math>)^2(x-$a)
  </me>
</p>

<p>
  Again, the given formula is for <m>y = f'(x)</m>. 
</p>

<p>
  <ol marker="a.">
    <li>
      <p>
        Use the provided formula for <m>y = f'(x)</m> to determine the critical numbers of <m>f</m> and report your results below.  If there is more than one critical number, enter them as a list separated by commas.  If there are none, enter <em>none</em>.
      </p>
      <p>
        <answer unorderedCompare matchPartial name="crNumAns">
          <mathInput name="crNum" >
            <label>
              The critical numbers of <m>f</m> are <m>x=</m> 
            </label>
          </mathInput>
          <award matchPartial>
            <when> $crNum=$correctCrNum</when></award>
          </answer>
      </p>
    </li>
    
    <!-- 
    <li>
      <p>
        Use the given graph of <m>y = f'(x)</m> to estimate the points of inflection of <m>f</m> and report your results below.  If there is more than one inflection point, enter them as a list separated by commas.  If there are none, enter <em>none</em>.
      </p>
      <p>
        <answer unorderedCompare matchPartial allowedErrorInNumbers="0.25" allowedErrorIsAbsolute>
          <mathInput name="POI">
            <label>
              The inflection points of <m>f</m> are <m>x=</m>  
            </label>
          </mathInput>
          <award>
            <when> $POI=$correctPOI</when>
          </award>
        </answer>.
      </p>

    </li>
    -->

      <!--
      <p>
        <m>POI1 = </m><number >$POI1</number>, <m>POI2 = </m><number >$POI2</number>
      </p>
      -->
    
    <li>
      <p>
        Since the only location where <m>f'</m> can change sign is at a critical number, <m>f'</m> is either exclusively positive or exclusively negative between any pair of adjacent critical numbers, as well as to the left of the least critical number and to the right of the greatest critical number.
      </p>
      <!-- <p>
        In the text boxes that lie above the number line, enter the sign of <m>f'</m> on the corresponding interval.  For example, if you determined that <m>3</m> and <m>7</m> were critical numbers and that <m>f'</m> is positive for all <m>x</m> that satisfy <m>3 \lt x \lt 7</m>, you would enter <q>POS</q> in the box above the number line on that interval, between the numbers <m>3</m> and <m>7</m>.  If instead you find <m>f'</m> is negative, enter <q>NEG</q>.  
      </p>
      <p>
        Enter <q>NEG</q> or <q>POS</q> in each of the top four boxes, and then check your answer below. (Note that the critical numbers automatically appear below once you have part a. correct.)
      </p> -->
      <p>
        In the text boxes that lie above the following number line, enter the sign of <m>f'</m> on the corresponding interval.  For example, if you determined that <m>3</m> and <m>7</m> were critical numbers and that <m>f'</m> is positive for all <m>x</m> that satisfy <m>3 \lt x \lt 7</m>, you would enter <q><m>+</m></q> in the box above the number line on that interval, between the numbers <m>3</m> and <m>7</m>.  If instead you find <m>f'</m> is negative, enter <q><m>-</m></q>.  
      </p>
      <p>
        Enter <m>-</m> or <m>+</m> in each of the top four boxes, and then check your answer below. (Note that the critical numbers automatically appear below once you have part a. correct.)
      </p>
      <answer name="signs" matchPartial>
        <award>
          <when>
            $condition1 and $condition2 and $condition3 and $condition4
          </when>
        </award>
      </answer>
      <graph xmin="-$end" xmax="$end" ymin="-2" ymax="2" size="large" grid="false" displayXAxis="false" displayYAxis="false" showNavigation="false" fixAxes="true" aspectRatio="3/1" showBorder="false">
        <shortDescription>
          a number line with boxes to fill in to build a sign chart
        </shortDescription>
        <description>
          ***
        </description>
        <!-- $numline -->
        $numline1 $numline2
        $hash1 $dash1
        $hash2 $dash2
        $hash3 $dash3

        <label hide="$crNumAns.creditAchieved!=1" fixLocation anchor="(-$a,-0.5)"><m>-$a</m></label>
        <label hide="$crNumAns.creditAchieved!=1" fixLocation anchor="($b,-0.5)"><m>$b</m></label>
        <label hide="$crNumAns.creditAchieved!=1" fixLocation anchor="($a,-0.5)"><m>$a</m></label>

        <label fixLocation anchor="(-$end+1.5,1.2)">sign<m>\left(f'\right)</m></label>
        <label fixLocation anchor="(-$end+1.6,-1.2)">behav<m>\left(f\right)</m></label>

        <textInput anchor="(-$a-2,.5)" name="pm1" width="10px" forAnswer="$signs" draggable="false"><shortDescription>enter + or -</shortDescription></textInput>        
        <textInput anchor="((-$a+$b)/2,.5)" name="pm2" width="10px" forAnswer="$signs" draggable="false"><shortDescription>enter + or -</shortDescription></textInput>      
        <textInput anchor="(($a+$b)/2,.5)" name="pm3" width="10px" forAnswer="$signs" draggable="false"><shortDescription>enter + or -</shortDescription></textInput>      
        <textInput anchor="($a+2,.5)" name="pm4" width="10px" forAnswer="$signs" draggable="false"><shortDescription>enter + or -</shortDescription></textInput>      

        <textInput anchor="(-$a-2,-.5)" name="ID1" width="35px" forAnswer="$behaviors" draggable="false"><shortDescription>enter INC or DEC</shortDescription></textInput>        
        <textInput anchor="((-$a+$b)/2,-.5)" name="ID2" width="35px" forAnswer="$behaviors" draggable="false"><shortDescription>enter INC or DEC</shortDescription></textInput>      
        <textInput anchor="(($a+$b)/2,-.5)" name="ID3" width="35px" forAnswer="$behaviors" draggable="false"><shortDescription>enter INC or DEC</shortDescription></textInput>      
        <textInput anchor="($a+2,-.5)" name="ID4" width="35px" forAnswer="$behaviors" draggable="false"><shortDescription>enter INC or DEC</shortDescription></textInput>    
        
      </graph>
      <p>
        In the text boxes that lie below the line, enter the corresponding behavior of <m>f</m> that aligns with the sign of the derivative on the interval.  Enter <q>INC</q> for increasing behavior; enter <q>DEC</q> for decreasing behavior.
      </p>
      <answer name="behaviors" matchPartial>
        <award>
          <when>
            $condition1a and $condition2a and $condition3a and $condition4a
          </when>
        </award>
      </answer>

    </li>
    <li>
      <p>
        Finally, use the sign chart to characterize the function's behavior at each of the critical numbers.  
      </p>
      <p hide="$crNumAns.creditAchieved=1">
        (The full prompt will only appear after you determine the correct critical numbers in (a).)
      </p>
      <p hide="$crNumAns.creditAchieved!=1">
        <ul>
          <li>
            <p>
              At <m>x = -$a</m>, <m>f</m> has 
              <choiceInput name="crNum1Beh" inline>
                <shortDescription>min, max, neither</shortDescription>
                <choice>a relative minimum</choice>
                <choice>a relative maximum</choice>
                <choice>neither a relative min nor max</choice>
              </choiceInput>
            </p>
          </li>
          <li>
            <p>
              At <m>x = $b</m>, <m>f</m> has 
              <choiceInput name="crNum2Beh" inline>
                <shortDescription>min, max, neither</shortDescription>
                <choice>a relative minimum</choice>
                <choice>a relative maximum</choice>
                <choice>neither a relative min nor max</choice>
              </choiceInput>
            </p>
          </li>
          <li>
            <p>
              At <m>x = $a</m>, <m>f</m> has 
              <choiceInput name="crNum3Beh" inline>
                <shortDescription>min, max, neither</shortDescription>
                <choice>a relative minimum</choice>
                <choice>a relative maximum</choice>
                <choice>neither a relative min nor max</choice>
              </choiceInput>
            </p>
          </li>
        </ul>
        <answer>
          <shortDescription>check answer</shortDescription>
          <award>
            <when>
              <and>
                $condition5
                $condition6
                $condition7
              </and>
            </when>
          </award>
        </answer>
      </p>
    </li>
  </ol>
</p>
