<setup>
  <selectFromSequence name="k" from="2" to="4" step="1"/>
  <selectFromSequence name="a" from="1" to="3" step="1" exclude="$k"/>

  <number name="n">5</number>
  <math name="b" simplify>$a + 2*$n</math>
  <math name="dx" simplify>2</math>

  <function name="f">$k/x</function>

  <number displayDecimals="6" name="L5">$dx * ($$f($a) + $$f($a+$dx) + $$f($a+2*$dx) + $$f($a+3*$dx) + $$f($a+4*$dx) )</number>
  <number displayDecimals="6" name="R5">$dx * ($$f($a+$dx) + $$f($a+2*$dx) + $$f($a+3*$dx) + $$f($a+4*$dx) + $$f($a+5*$dx) )</number>>
  <number displayDecimals="6" name="M5">$dx * ($$f($a+$dx/2) + $$f($a+3*$dx/2) + $$f($a+5*$dx/2) + $$f($a+7*$dx/2) + $$f($a+9*$dx/2) )</number>>
  <number displayDecimals="6" name="T5">($L5 + $R5)/2</number>>
  <number displayDecimals="6" name="S10">(2*$M5 + $T5)/3</number>>
  <math simplify name="exactInt">$k*ln($b) - $k*ln($a) </math>

  <number name="S10computed" displayDecimals="7">(2*$M5entered+$T5entered)/3</number>

</setup>
  <p>
    Consider the definite integral
    <me>
      \int_$a^{$b} \frac{$k}{x} \, dx
    </me>
  </p>

<p>
  <ol marker="a.">
    <li>
      <p>
        Determine the estimates <m>L_5</m>, <m>R_5</m>, <m>T_5</m>, and <m>M_5</m> for the given definite integral.  Report each result as a single decimal number, accurate to <m>0.000001</m>.
      </p>
      <p>
        <answer symbolicEquality allowedErrorInNumbers="0.000001" allowedErrorIsAbsolute name="L5entered"><label><m> \int_$a^{$b} \frac{$k}{x} \, dx \approx L_5 = </m></label> $L5</answer>
      </p>
      <p>
        <answer symbolicEquality allowedErrorInNumbers="0.000001" allowedErrorIsAbsolute name="R5entered"> <label><m> \int_$a^{$b} \frac{$k}{x} \, dx \approx R_5 = </m></label>$R5</answer>
      </p>
      <p>
        <answer symbolicEquality allowedErrorInNumbers="0.000001" allowedErrorIsAbsolute name="M5entered"><label><m> \int_$a^{$b} \frac{$k}{x} \, dx \approx M_5 = </m></label> $M5</answer>
      </p>
      <p>

        <answer name="T5ans" allowedErrorInNumbers="0.000001" allowedErrorIsAbsolute forceSmallCheckWorkButton>
          <mathInput name="T5entered">
          <label><m> \int_$a^{$b} \frac{$k}{x} \, dx \approx T_5 = </m></label>
            </mathInput>
          <award symbolicEquality><when>
            $T5entered = <number>($L5entered + $R5entered)/2</number>
            and $L5entered.creditAchieved=1 and $R5entered.creditAchieved=1
          </when></award>
          <award credit="0" name="needdecimal"><when>
            $T5entered = <number>($L5entered + $R5entered)/2</number>
            and $L5entered.creditAchieved=1 and $R5entered.creditAchieved=1
          </when></award>
          <award credit="0" name="trapformulaused">
            $T5
          </award>
        </answer>
      </p>
      <feedback condition="$needdecimal">Make sure you are entering a decimal, not a calculation.</feedback>
      <feedback condition="$trapformulaused">Make sure you have <m>L_5</m> and <m>R_5</m> correct before attempting to enter <m>T_{5}</m>. You should be using <me>T_{5}=\frac{L_5+R_5}{2}.</me> </feedback>
    </li>
    <li>
      <p>
        Find the estimate that results from using Simpson's Rule with <m>10</m> subintervals.  Report your result as a single decimal number, accurate to <m>0.000001</m>.
      </p>
      <p>
        <answer allowedErrorInNumbers="0.000001" allowedErrorIsAbsolute>
          <mathInput name="S10entered">
            <label><m> \int_$a^{$b} \frac{$k}{x} \, dx \approx S_{10} = </m></label>
          </mathInput>
          <award symbolicEquality>
            <when>
              $S10entered = <number>(2*$M5entered+$T5entered)/3</number>
              and $T5ans.creditAchieved=1 and $M5entered.creditAchieved=1
            </when>
          </award>
          <award credit="0" name="Simpformulaused"><when>
            $S10entered = $S10
          </when>
          </award>
        </answer>
      </p>
      <feedback condition="$Simpformulaused">Enter your answer as a decimal, and make sure you have <m>M_5</m> and <m>T_5</m> correct before attempting to enter <m>S_{10}</m>. You should be using <me>S_{10}=\frac{2M_5+T_5}{3}.</me></feedback>
    </li>
    <li>
      <p>
        The exact value of the integral turns out to be
        <me>
          \int_$a^{$b} \frac{$k}{x} \, dx = <math name="exact" simplify>$k*ln($b) - $k*ln($a)
          </math>\approx<number displayDecimals="7">$exact</number>
        </me>
        Simpson's Rule therefore <choiceInput name="c1" inline>
          <shortDescription>under, over, or equal</shortDescription>
          <choice>?</choice>
          <choice>underestimates</choice>
          <choice>overestimates</choice>
          <choice>exactly matches</choice>
        </choiceInput> the value of the definite integral.
      </p>
      <p>
        <answer><award><when>
          ($c1.selectedIndices=2 and $exactInt>$S10)
          or
          ($c1.selectedIndices=3 and $S10>$exactInt)
          or
          ($c1.selectedIndices=4 and $S10=$exactInt)
        </when></award></answer>
      </p>

    </li>

  </ol>
</p>