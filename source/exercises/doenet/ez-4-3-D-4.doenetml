<setup>
  <selectFromSequence name = "m1" from = "0.25" to = "0.75" step = "0.25"/>
  <selectFromSequence name = "m2" from = "-1.5" to = "-0.5" step = "0.5"/>
  <selectFromSequence name = "n1" from = "-2" to = "-1" step = "0.5"/>
  <selectFromSequence name = "n2" from = "0.5" to = "1" step = "0.25"/>
  <selectFromSequence name = "x1" from = "1" to = "2" step = "1"/>
  <selectFromSequence name = "x2" from = "-2" to = "-1" step = "1"/>
  <selectFromSequence name = "y1" from = "1" to = "2" step = "1"/>
  <selectFromSequence name = "y2" from = "-3" to = "-2" step = "1"/>
  <selectFromSequence name = "a" from = "-3" to = "-2" step = "1"/>
  <selectFromSequence name = "b" from = "2" to = "3" step = "1"/>

  <piecewiseFunction name="f" symbolic="false" styleNumber="1">
    <function domain="(-infinity,$x1)">$m1*(x-$x1)+$y1</function>
    <function domain="[$x1,infinity)">$m2*(x-$x1)+$y1</function>
  </piecewiseFunction>

  <piecewiseFunction name="F" symbolic="false" styleNumber="2">
    <function domain="(-infinity,$x1)">($m1/2*(x-$x1)^2+$y1*x)</function>
    <function domain="[$x1,infinity)">($m2/2*(x-$x1)^2+$y1*x)</function>
  </piecewiseFunction>

  <piecewiseFunction name="fP" symbolic="false"  styleNumber="3">
    <function domain="(-infinity,$x1)">$m1</function>
    <function domain="[$x1,$x1]">undefined</function>
    <function domain="($x1,infinity)">$m2</function>
  </piecewiseFunction>

  <piecewiseFunction name="g" symbolic="false" styleNumber="4">
    <function domain="(-infinity,$x2)">$n1*(x-$x2)+$y2</function>
    <function domain="[$x2,infinity)">$n2*(x-$x2)+$y2</function>
  </piecewiseFunction>

  <piecewiseFunction name="G" symbolic="false" styleNumber="2">
    <function domain="(-infinity,$x2)">($n1/2*(x-$x2)^2+$y2*x)</function>
    <function domain="[$x2,infinity)">($n2/2*(x-$x2)^2+$y2*x)</function>
  </piecewiseFunction>

  <piecewiseFunction name="gP" symbolic="false"  styleNumber="4">
    <function domain="(-infinity,$x2)">$n1</function>
    <function domain="[$x2,$x2]">undefined</function>
    <function domain="($x2,infinity)">$n2</function>
  </piecewiseFunction>

  <math name="intF">$$F($b)-$$F($a)</math>
  <math name="intG">$$G($b)-$$G($a)</math>

  <boolean name="Fsigns">
    ($intF > 0 and $c1.selectedIndices=3 and $c3.selectedIndices=3) or
    ($intF < 0 and $c1.selectedIndices=2 and $c3.selectedIndices=2) or
    ($intF = 0 and $c1.selectedIndices=4 and $c3.selectedIndices=4)
  </boolean>

  <boolean name="Gsigns">
    ($intG > 0 and $c2.selectedIndices=3 and $c4.selectedIndices=3) or
    ($intG < 0 and $c2.selectedIndices=2 and $c4.selectedIndices=2) or
    ($intG = 0 and $c2.selectedIndices=4 and $c4.selectedIndices=4)
  </boolean>

</setup>

<p>
    Let <m>f</m> and <m>g</m> be the piecewise linear functions given by the graphs below.  Consider the respective regions that each of these functions bound on the interval <m>[$a, $b]</m>.
</p>

<sideBySide widths="40% 40%">
      <graph size="small" xmin="-5" xmax="5" ymin="-5" ymax="5" size="medium" grid="true" showNavigation="false" fixAxes="true">
        $f
        <regionBetweenCurveXAxis function="$f" boundaryValues="$a $b" styleNumber="3"/>
          <label fixLocation anchor="($x1+0.5,$$f($x1)+0.35)"><m>f</m></label>
      </graph>
      <graph size="small" xmin="-5" xmax="5" ymin="-5" ymax="5" size="medium" grid="true" showNavigation="false" fixAxes="true">
        $g
        <regionBetweenCurveXAxis function="$g" boundaryValues="$a $b" styleNumber="2"/>
          <label fixLocation anchor="($x2+0.25,$$g($x2)-0.35)"><m>g</m></label>
      </graph>
</sideBySide>

<p>
  Reason graphically to determine the sign of each of the following quantities.
</p>
<p>
  <ul>
    <li>
      <p>
        <m>\displaystyle \int_{$a}^{$b} f(x) \, dx</m> is <choiceInput name="c1" inline>
          <choice>?</choice>
          <choice>negative</choice>
          <choice>positive</choice>
          <choice>zero</choice>
        </choiceInput>
      </p>
    </li>
    <li>
      <p>
        <m>\displaystyle \int_{$a}^{$b} g(x) \, dx</m> is <choiceInput name="c2" inline>
          <choice>?</choice>
          <choice>negative</choice>
          <choice>positive</choice>
          <choice>zero</choice>
        </choiceInput>
      </p>
    </li>
    <li>
      <p>
        <m>\displaystyle f_{\small{\text{AVG}}[$a,$b]}</m> is <choiceInput name="c3" inline>
          <choice>?</choice>
          <choice>negative</choice>
          <choice>positive</choice>
          <choice>zero</choice>
        </choiceInput>
      </p>
    </li>
    <li>
      <p>
        <m>\displaystyle g_{\small{\text{AVG}}[$a,$b]}</m> is <choiceInput name="c4" inline>
          <choice>?</choice>
          <choice>negative</choice>
          <choice>positive</choice>
          <choice>zero</choice>
        </choiceInput>
      </p>
    </li>
  </ul>
</p>
<p>
  <answer><award><when> $Fsigns and $Gsigns </when></award></answer>
</p>
