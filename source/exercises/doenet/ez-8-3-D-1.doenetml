<setup>
  <selectFromSequence name="n" from="6" to="8" step="1"/>
  <selectFromSequence name="m" from="2" to="5" step="1" exclude="$n"/>  
  <selectFromSequence name="a1" from="3" to="8" step="1" exclude="$n $m 4 5"/> 
  <selectFromSequence name="a2" from="3" to="8" step="1" exclude="$n $m $a1 4 5"/> 
  <selectFromSequence name="a3" from="2" to="9" step="1" exclude="$n $m $a1 $a2 4 5"/> 
  
  <math name="r1">1/4</math>
  <math name="r2">-1/5</math>
  <math name="r3">1/8</math>  
</setup>  
<p>
  Determine the exact (fractional) value of each of the following finite geometric series.  For each, identify the first term, <m>a</m>, the value of the ratio, <m>r</m>, and the number of terms, <m>n</m>, in the sum, plus state the sum's exact (fractional) value.
</p>

<p>
  <ol marker="a.">
    <li>
      <p>
        <m> \displaystyle S_n = $a1 + \frac{$a1}{4} + \frac{$a1}{16} + \cdots + \frac{$a1}{4^{<math simplify>$n-1</math>}}</m>
      </p>
      <p>
        <m>r = </m><answer>$r1</answer>
      </p>
      <p>
        <m>a = </m><answer>$a1</answer>
      </p>
      <p>
        <m>n = </m><answer>$n</answer>
      </p>
      <p>
        <m>S_n = </m><answer>($a1-$a1*$r1^$n)/(1-$r1)</answer>
      </p>
    </li>
    <li>
      <p>
        <m> \displaystyle S_n = \frac{$a2}{4^$m} + \frac{$a2}{4^{<math simplify>$m+1</math>}} + \frac{$a2}{4^{<math simplify>$m+2</math>}} + \cdots + \frac{$a2}{4^{<math simplify>$m + $n - 2</math>}}</m>
      </p>
      <p>
        <m>r = </m><answer>$r1</answer>
      </p>
      <p>
        <m>a = </m><answer>$a2/4^$m</answer>
      </p>
      <p>
        <m>n = </m><answer>$n-1</answer>
      </p>
      <p>
        <m>S_n = </m><answer>($a2/4^$m-$a2/4^$m*$r1^($n-1))/(1-$r1)</answer>
      </p>
    </li>
    <li>
      <p>
        <m> \displaystyle S_n = $a3 -\frac{$a3}{5} + \frac{$a3}{25} + \cdots + (-1)^{<math simplify>$n-2</math>} \frac{$a3}{5^{<math simplify>$n-2</math>}}</m>
      </p>
      <p>
        <m>r = </m><answer>$r2</answer>
      </p>
      <p>
        <m>a = </m><answer>$a3</answer>
      </p>
      <p>
        <m>n = </m><answer>$n-1</answer>
      </p>
      <p>
        <m>S_n = </m><answer>($a3-$a3*$r2^($n-1))/(1-$r2)</answer>
      </p>
    </li>
    <li>
      <p>
        <m> \displaystyle S_n = -\frac{$a1}{5^{<math simplify>$m+1</math>}} + \frac{$a1}{5^{<math simplify>$m+2</math>}} - \frac{$a1}{5^{<math simplify>$m+3</math>}} + \cdots + (-1)^{<math simplify>$m + $n - 1</math>}\frac{$a1}{5^{<math simplify>$m + $n + 1</math>}}</m>
      </p>
      <p>
        <m>r = </m><answer>$r2</answer>
      </p>
      <p>
        <m>a = </m><answer>-$a1/5^($m+1)</answer>
      </p>
      <p>
        <m>n = </m><answer>$n+1 </answer>
      </p>
      <p>
        <m>S_n = </m><answer>(-$a1/5^($m+1)+$a1/5^($m+1)*$r2^($n+1))/(1-$r2)</answer>
      </p>
    </li>
  </ol>
</p>
    
