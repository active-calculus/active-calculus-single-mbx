 <setup>
  <selectFromSequence name = "k" from = "5" to = "9" step = "1"/>
  <selectFromSequence name = "a" from = "2" to = "6" step = "1" exclude="$k"/>

  <function name="f">$a*x*cos($k*x)</function>
  <function name="antiDfx"></function>

  <function name="u">$a*x</function>
  <function name="du">$a</function>

  <function name="dv">cos($k*x)</function>
  <function name="v">1/$k*sin($k*x)</function>

  <function name="uv">$a*x*1/$k*sin($k*x)</function>
  <function name="vdu">$a*1/$k*sin($k*x)</function>

  <function name="intvdu">-$a*1/($k^2)*cos($k*x)</function>

  <boolean name="correctSubsFound">($uvChoice=$uv) and ($vduChoice=$vdu)</boolean>

  <boolean name="udvisintegrand">$uChoice*$dvChoice = $f</boolean>

  <boolean name="almostu"> $uChoice = <math>x</math> </boolean>
  <boolean name="possibleu"> $almostu or $uChoice = $u </boolean>

  <boolean name="udvanddu">$duChoice = <derivative>$uChoice</derivative> and $udvChoice.creditAchieved=1</boolean>
  <boolean name="udvandv"><derivative>$vChoice</derivative> = $dvChoice and $udvChoice.creditAchieved=1</boolean>



</setup>

<p>
  Consider the indefinite integral
  <me>
    \int $f \, dx.
  </me>
  Since the integrand is a product of basic functions, we will use Integration by Parts to evaluate the integral.
</p>
<p>
  Choose <m>u</m> and <m>dv</m> appropriately and report your results in the blanks below.
</p>

<p>
  <m>u = </m><mathInput name="uChoice"/>  <m>\qquad \qquad dv = </m><mathInput name="dvChoice"/><m>dx =</m><mathInput disabled>$dvChoice dx </mathInput>
  <answer name="udvChoice"><award><when>$possibleu and $udvisintegrand </when></award></answer>
</p>
<feedback condition="!$udvisintegrand and $udvChoice.justSubmitted">You are rewriting the given integral, which means that <m>u</m> and <m>dv</m> must multiply to <m>$f dx</m>.
</feedback>
<p>
  Now calculate <m>du</m> and <m>v</m>.
</p>
<p>
  <m>du = </m><mathInput name="duChoice"/><m>dx</m>

  <m>\qquad \quad v = </m><mathInput name="vChoice"/> <answer><award><when matchPartial> $udvanddu and $udvandv</when></award></answer>
</p>

<p>
  Next, fill in the blanks in the Integration by Parts formula using the substitutions you found above.
</p>
<p>
  <m>\displaystyle \int $f \, dx = </m><mathInput name="uvChoice"/><m>\displaystyle - \int</m>  <mathInput name="vduChoice"/><m>dx</m> <answer><award><when matchPartial>($uvChoice=$uv) and ($vduChoice=$vdu)</when></award></answer>
</p>


<p hide="$correctSubsFound">
  (<em>A final prompt will appear here after you correctly apply the substitutions in the last step above.</em>)
</p>
<div hide="not $correctSubsFound">
  <p>
    Finally, evaluate the remaining indefinite integral to complete the process of Integration by Parts.
  </p>
  <p>
    <m>\displaystyle \int $f \, dx = <math simplify>$u*$v</math> - </m> <mathInput name="intvduChoice"/> <m>+ C</m> <answer><award><when> $intvdu = $intvduChoice</when></award></answer>
  </p>

</div>