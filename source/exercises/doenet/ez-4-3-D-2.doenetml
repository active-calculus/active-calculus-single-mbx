<setup>

  <selectFromSequence name = "pm" from = "-1" to = "1" step = "2"/>
  <selectFromSequence name = "n1" from = "-2" to = "-1" step = "0.5"/>
  <selectFromSequence name = "n2" from = "0.5" to = "1" step = "0.5"/>
  <selectFromSequence name = "x1" from = "1" to = "2" step = "1"/>
  <selectFromSequence name = "x2" from = "-2" to = "-1" step = "1"/>
  <selectFromSequence name = "y1" from = "2" to = "3" step = "1"/>
  <selectFromSequence name = "y2" from = "-3" to = "-2" step = "1"/>
  

  <piecewiseFunction name="g" symbolic="false" styleNumber="1">
    <function domain="(-infinity,$x2)">$pm*($n1*(x-$x2)+$y2)</function>
    <function domain="[$x2,infinity)">$pm*($n2*(x-$x2)+$y2)</function>
  </piecewiseFunction>

  <piecewiseFunction name="G" symbolic="false" styleNumber="2">
    <function domain="(-infinity,$x2)">$pm*($n1/2*(x-$x2)^2+$y2*x)</function>
    <function domain="[$x2,infinity)">$pm*($n2/2*(x-$x2)^2+$y2*x)</function>
  </piecewiseFunction>
  
  <piecewiseFunction name="gP" symbolic="false"  styleNumber="4">
    <function domain="(-infinity,$x2)">$n1</function>
    <function domain="[$x2,$x2]">undefined</function>
    <function domain="($x2,infinity)">$n2</function>
  </piecewiseFunction>

  <math name="z1" simplify>-$y2/$n1 + $x2</math>
  <math name="z2" simplify>-$y2/$n2 + $x2</math>
  
</setup>

<p>
    Let <m>g</m> be the piecewise linear function given by the graph below.
</p>
      <graph xmin="-6" xmax="6" ymin="-6" ymax="6" size="medium" grid="true" showNavigation="false" fixAxes="true">   
        $g  
        <label fixLocation anchor="($x2+0.25,$$g($x2)-0.25*$pm)"><m>g</m></label>
      </graph>

<p>
  Reason graphically and geometrically to determine the exact value of each of the following definite integrals.
</p>

<p>
  <ol marker="a.">
    <li>
      <p>
        <m>\displaystyle \int_{$x2}^{$z2} g(x) \, dx = </m><answer allowedErrorInNumbers="0.01" allowedErrorIsAbsolute>$$G($z2)-$$G($x2)</answer>
      </p>
    </li>
    <li>
      <p>
        <m>\displaystyle \int_{$z1}^{$z2} g(x) \, dx = </m><answer allowedErrorInNumbers="0.01" allowedErrorIsAbsolute>$$G($z2)-$$G($z1)</answer>
      </p>
    </li>  
    <li>
      <p>
        <m>\displaystyle \int_{-5}^5 g(x) \, dx = </m><answer allowedErrorInNumbers="0.01" allowedErrorIsAbsolute>$$G(5)-$$G(-5)</answer>
      </p>
    </li>   
    <li>
      <p>
        <m>\displaystyle \int_{-5}^5 |g(x)| \, dx = </m><answer allowedErrorInNumbers="0.01" allowedErrorIsAbsolute>abs($$G($z1)-$$G(-5)) + abs($$G($z2)-$$G($z1)) + abs($$G(5)-$$G($z2))</answer>
      </p>
    </li>    
  </ol>
</p>