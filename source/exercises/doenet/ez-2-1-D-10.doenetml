<!-- this exercise was developed by Spencer Bagley as part of the PROTEUS grant-->

<setup>
    <mathList name="flats">
        pi/2 3*pi/2 5*pi/2 -pi/2 -3*pi/2 -5*pi/2
    </mathList>
    <subsetOfReals name="incs">
        (-5*pi/2, -3*pi/2) union
        (-pi/2, pi/2) union
        (3*pi/2, 5*pi/2)
    </subsetOfReals>
    <subsetOfReals name="decs">
        (-7*pi/2, -5*pi/2) union
        (-3*pi/2, -pi/2) union
        (pi/2, 3*pi/2) union
        (5*pi/2, 7*pi/2)
    </subsetOfReals>
    <mathList name="mins">
        -3*pi -pi pi 3*pi
    </mathList>
</setup>
<p>
  Consider the graph of the function <m>f(x) = \sin(x)</m>.
</p>
  <graph
      size="large"
      fixAxes="true" showNavigation="false"
      identicalAxisScales
      xTickScaleFactor="pi"
      displayYAxisTicks="false"
      ymin="-2" ymax="2" >
      <shortDescription>a plot of the sine function</shortDescription>
      <function name="f">sin(x)</function>
  </graph>
<p>
    <ol marker="a.">
        <li>
          <p>
            From the graph, determine three exact values where <m>f'(x) = 0</m>. 
          </p>
          <p>
            (Remember, <m>f'(x) = 0</m> wherever the tangent line to <m>f(x)</m> is horizontal; each correct answer will be a whole number or fractional multiple of <m>\pi</m>.)
          </p>
          <p>
            <answer matchPartial>
                <mathInput name="x1">
                    <label><m>x = </m></label>
                </mathInput>
                <mathInput name="x2">
                    <label><m>x = </m></label>
                </mathInput>
                <mathInput name="x3">
                    <label><m>x = </m></label>
                </mathInput>
                <award><when>
                    $x1 elementof $flats and
                    $x2 elementof $flats and
                    $x3 elementof $flats 
                </when></award>
            </answer>
          </p>
        </li>
        <li>
          <p>
            From the graph, determine one interval where <m>f'(x) > 0</m>.  State the interval in ordered pair notation: e.g., for <m>a < x < b</m>, enter <m>(a,b)</m>.
          </p>
          <p>
              <answer>
                  <mathInput name="incInterval">
                      <label><m>f'(x) > 0</m> on </label>
                  </mathInput>
                  <award><when>$incInterval subset $incs </when></award>
              </answer>
          </p>
        </li>
        <li>
          <p>
            From the graph, determine one interval where <m>f'(x) < 0</m>. 
          </p>
          <p>
            <answer>
                <mathInput name="decInterval">
                    <label><m>f'(x) > 0</m> on </label>
                </mathInput>
                <award><when>$decInterval subset $decs </when></award>
            </answer>
          </p>
        </li>
        <li>
          <p>
            What is an <m>x</m>-value at which you think <m>f'(x)</m> is the most negative?
          </p>
          <p>
            <answer>
                <mathInput name="mostNeg">
                    <label><m>x=</m></label>
                </mathInput>
                <award><when>
                    $mostNeg elementof $mins
                </when></award>
            </answer>
          </p>
        </li>
    </ol>
</p>