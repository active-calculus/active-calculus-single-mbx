<setup>
  <selectFromSequence name="p" from="0.1" to="0.3" step="0.1" />
  <selectFromSequence name="q" from="-0.3" to="0.1" step="0.1" exclude="0 abs($p)"/>
  <selectFromSequence name="r" from="-0.5" to="0.5" step="0.25" exclude="$p $q $0"/>
  <selectFromSequence name="pm" from="-1" to="1" step="2" />
  
  <function name="f">$pm*($p*x^2 + $q*x + $r)</function>
  <function name="fP">$pm*(2*$p*x + $q)</function>
  <function name="fPP">$pm*(2*$p)</function>
 
  <math name="c0">$$f($a)</math>
  <math name="c1">$$fP($a)</math>
  <math name="c2">$$fPP($a)/2</math>
    
  <selectFromSequence name="a" from="2" to="4" step="1"/>

  <function name="T2">$c0 + $c1*(x-$a) + $c2*(x-$a)^2</function>
  <function name="T2Symb">c_0 + c_1*(x-$a) + c_2*(x-$a)^2</function>

  <function name="T1">$c0 + $c1*(x-$a)</function>
  <function name="T1Symb">c_0 + c_1*(x-$a)</function>

  <point styleNumber="6" name="P" draggable="false">($a, $$f($a))</point>

</setup>

<p>
  Let <m>f(x)</m> be an unknown function and suppose that <m>T_2(x)</m> is the degree <m>2</m> Taylor polynomial of <m>f</m> centered at <m>a = $a</m>.  The figure shows a graph of <m>y = T_2(x)</m>.
</p>

<!--
<p>
  $f, $p, $q, $r, $P, $a
</p>
-->

<graph size="medium" xMin="-1" xMax="6" yMin="-5" yMax="5" showNavigation="false" fixAxes="True">
  $f
  <label anchor="(1.5, 1.5)"><m>y = T_2(x)</m></label>
  $P
</graph>

<p>
  <ol marker="a.">
    <li>
      <p>
        Determine the signs of <m>f($a)</m>, <m>f'($a)</m>, and <m>f'''($a)</m>.  
      </p>    
      <p>
        <m>f($a)</m> is <choiceInput name="const" inline>
          <choice>?</choice>
          <choice>negative</choice>
          <choice>zero</choice>
          <choice>positive</choice>
        </choiceInput>
      </p>
      <p>
        <m>f'($a)</m> is <choiceInput name="slope" inline>
          <choice>?</choice>
          <choice>negative</choice>
          <choice>zero</choice>
          <choice>positive</choice>
        </choiceInput>
      </p>
      <p>
        <m>f''($a)</m> is <choiceInput name="concav" inline>
          <choice>?</choice>
          <choice>negative</choice>
          <choice>zero</choice>
          <choice>positive</choice>
        </choiceInput>
      </p>
      <p>
        <answer><award><when>
          ( ($$f($a) > 0 and $const.selectedIndices=4) or (0 > $$f($a) and $const.selectedIndices=2) )
          and
          ( ($$fP($a) > 0 and $slope.selectedIndices=4) or (0 > $$fP($a) and $slope.selectedIndices=2) )
          and
          ( ($$fPP($a) > 0 and $concav.selectedIndices=4) or (0 > $$fPP($a) and $concav.selectedIndices=2) )
        </when></award></answer>
      </p>
    </li>
    <li>
      <p>
        Complete the following sentence to describe the behavior of <m>f(x)</m> near <m>x = $a</m>.  
      </p>    
      <p>
        Near <m>x=$a</m>, <m>f(x)</m> is <choiceInput name="fconst" inline>
          <choice>?</choice>
          <choice>negative</choice>
          <choice>zero</choice>
          <choice>positive</choice>
        </choiceInput>, 
        <m>f(x)</m> is <choiceInput name="fslope" inline>
          <choice>?</choice>
          <choice>decreasing</choice>
          <choice>constant</choice>
          <choice>increasing</choice>
        </choiceInput>,
        and <m>f(x)</m> is <choiceInput name="fconcav" inline>
          <choice>?</choice>
          <choice>concave down</choice>
          <choice>linear</choice>
          <choice>concave up</choice>
        </choiceInput>
      </p>
      <p>
        <answer><award><when>
          ( ($$f($a) > 0 and $fconst.selectedIndices=4) or (0 > $$f($a) and $fconst.selectedIndices=2) )
          and
          ( ($$fP($a) > 0 and $fslope.selectedIndices=4) or (0 > $$fP($a) and $fslope.selectedIndices=2) )
          and
          ( ($$fPP($a) > 0 and $fconcav.selectedIndices=4) or (0 > $$fPP($a) and $fconcav.selectedIndices=2) )
        </when></award></answer>
      </p>
    </li>
    <li>
      <p>
        Which of the following is a possible formula for <m>T_1(x)</m>, the degree <m>1</m> Taylor polynomial approximation of <m>f</m> at <m>a = $a</m>?
      </p>
      <answer>
        <choiceInput>
          <choice><m>T_1(x) = <math simplify>-1*$T1</math></m></choice>
          <choice credit="1"><m>T_1(x) = $T1</m></choice>
          <choice><m>T_1(x) = <math simplify>$c0 - $c1*(x-$a)</math></m></choice>
          <choice><m>T_1(x) = <math simplify>-$c0 + $c1*(x-$a)</math></m></choice>
        </choiceInput>
      </answer>
    </li>
  </ol>
</p>