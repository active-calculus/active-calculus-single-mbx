                    <m>AV_{[1,1+h]}</m>
                  </cell>
                </row>
                <row>
                  <cell>
                    <m>0.1</m>
                  </cell>
                  <cell>
                    <m>-54.50145823</m>
                  </cell>
                </row>
                <row>
                  <cell>
                    <m>0.01</m>
                  </cell>
                  <cell>
                    <m>-53.90917396</m>
                  </cell>
                </row>
                <row>
                  <cell>
                    <m>0.001</m>
                  </cell>
                  <cell>
                    <m>-53.84429251</m>
                  </cell>
                </row>
                <row>
                  <cell>
                    <m>0.0001</m>
                  </cell>
                  <cell>
                    <m>-53.83774757</m>
                  </cell>
                </row>
                <row>
                  <cell>
                    <m>-0.1</m>
